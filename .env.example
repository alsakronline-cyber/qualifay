# ============================================================
# AI WhatsApp CRM — Environment Configuration
# Copy to .env and fill in your values
# ============================================================

# ─── Database ─────────────────────────────────────────────
POSTGRES_DB=wacrm
POSTGRES_USER=crmadmin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ─── Evolution API (WhatsApp) ─────────────────────────────
# Replace with your server's public IP or domain
EVOLUTION_SERVER_URL=http://YOUR_SERVER_IP:8080
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_KEY_32CHARS

# ─── Backend ──────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_SECRET_KEY_64CHARS_RANDOM
ENVIRONMENT=production
CORS_ORIGINS=http://YOUR_SERVER_IP,https://YOUR_DOMAIN

# ─── URLs (for internal + external routing) ───────────────
BACKEND_URL=http://backend:5000
BACKEND_PUBLIC_URL=http://YOUR_SERVER_IP/api
WS_PUBLIC_URL=ws://YOUR_SERVER_IP/ws

# ─── OpenRouter (FREE LLMs — no cost) ────────────────────
# Get your free key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXX

# ─── LLM Model Selection (all free) ──────────────────────
# Primary: best reasoning
OPENROUTER_PRIMARY_MODEL=deepseek/deepseek-r1:free
# Fast: quick intent classification
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Auto fallback
OPENROUTER_FALLBACK_MODEL=openrouter/auto:free

# ─── CRM Settings ─────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@yourcompany.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASS

# ─── AI Behaviour ─────────────────────────────────────────
AI_AUTO_REPLY_ENABLED=true
AI_AUTO_REPLY_DELAY_SECONDS=2
AI_CONFIDENCE_THRESHOLD=0.75
AI_LANGUAGE=auto  # auto-detect or set: en, ar, fr, etc.

# ─── Off-box backups (optional but recommended) ──────────────
# Nightly DB dumps also live in MinIO, but MinIO is on the SAME server as Postgres —
# a disk loss takes both. Set an S3-compatible target below and each dump is pushed
# off-box too. Example is Backblaze B2 (10GB free); AWS S3 / Wasabi work the same.
# Leave blank to disable (backups still run locally).
BACKUP_S3_ENDPOINT=          # e.g. s3.us-west-004.backblazeb2.com  (host only, no https://)
BACKUP_S3_BUCKET=            # e.g. qualifay-backups
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_SECURE=true
